# Copy to backend/.env and fill in. Used by both `npm run dev` and `docker compose up`.

# --- Postgres (shared instance; ask a maintainer for credentials) ---
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
# Use the hostname on the DB's TLS certificate (not the IP) so verify-full works.
# disable | require (no cert check) | verify-ca | verify-full (default)
PGSSLMODE=verify-full
# Same DB as a URL, for schema migrations (`docker compose run --rm migrate ...`).
# URL-encode special characters in the password.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full

# --- App ---
# 1 = auto-reload + debug tracebacks (dev). Set 0 anywhere shared.
API_DEBUG=1
# How many backend/logs/run_* folders to keep (0 = keep all)
LOG_KEEP_RUNS=20
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FRONTEND_URL=http://localhost:5173
# Comma-separated; defaults to FRONTEND_URL
# CORS_ORIGINS=http://localhost:5173

# --- Google OAuth (Google sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; docker-compose sets this for you
# GOOGLE_REDIRECT_URI=http://localhost:5010/api/auth/google/callback

# --- Ollama (email classifier) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
